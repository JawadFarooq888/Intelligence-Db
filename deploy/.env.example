# Copy to .env and fill in. Never commit .env.

# Domain of the portal, pointing (DNS A record) to this server, e.g. monitor.example.com
DOMAIN=monitor.example.com

# First portal admin (created on the first start only). Password: 12+ chars, upper, lower, digit, symbol.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Change-Me-2026!

# SQL Server "sa" password of the repository container (8+ chars, upper, lower, digit, symbol).
SQL_SA_PASSWORD=Change-Me-Sql-2026!

# Random secret, at least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SIGNING_KEY=

# Optional: use Amazon RDS (or another SQL Server) for the repository instead of the "sql" container.
# REPO_CONNECTION=Server=mydb.xxxx.eu-west-1.rds.amazonaws.com,1433;Database=IntelligenceDB_Repo;User Id=admin;Password=...;Encrypt=True;TrustServerCertificate=True

# Optional
# MSSQL_PID=Express
# MSSQL_MEMORY_LIMIT_MB=2048
# WORKER_PARALLEL=16
