  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IntelligenceDB.UnitTests" />
    <InternalsVisibleTo Include="IntelligenceDB.IntegrationTests" />
  </ItemGroup>
</Project>
