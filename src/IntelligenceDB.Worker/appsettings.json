{
  "ConnectionStrings": {
    "Repository": ""
  },
  "Worker": {
    "MaxParallelServers": 16
  },
  "Monitoring": {
    "Thresholds": {
      "FullBackupMaxAgeHours": 168,
      "LogBackupMaxAgeHours": 24,
      "CheckDbMaxAgeDays": 14
    },
    "LatestBuilds": [],
    "Retention": {
      "MetricsDays": 14,
      "WaitsDays": 30,
      "BackupsDays": 90
    }
  },
  "DataProtection": {
    "CertificatePath": "",
    "CertificatePassword": "",
    "UseDpapi": false
  },
  "Logging": {
    "FilePath": "logs/worker-.log"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Quartz": "Warning",
        "System": "Warning"
      }
    }
  }
}
