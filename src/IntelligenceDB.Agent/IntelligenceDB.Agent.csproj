<Project Sdk="Microsoft.NET.Sdk.Worker">
  <!--
    IntelligenceDB Agent: installed on ONE machine inside a customer network. It monitors the SQL Servers
    there and sends the results OUT to the portal over HTTPS. No inbound firewall ports are needed.
    It does not use the repository database.
  -->
  <PropertyGroup>
    <RootNamespace>IntelligenceDB.Agent</RootNamespace>
    <AssemblyName>IntelligenceDB.Agent</AssemblyName>
    <UserSecretsId>intelligencedb-agent</UserSecretsId>
    <Version>0.2.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\IntelligenceDB.Targets\IntelligenceDB.Targets.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>
</Project>
